digraph ChairNotificationDeliveryState {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.43", ranksep="0.48", fontname="Hiragino Sans", labelloc="t", label="Benchmark 36: chair通知がrideを選ぶ配送状態機械", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.16,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  poll [label="chair通知poll"];
  active [shape=diamond, label="MATCHING送信済み かつ\nCOMPLETED未送信のrideがあるか"];
  continue_ride [label="優先度1\n現在のrideを継続\n次の未送信statusを返す", fillcolor="#d8efeb"];
  new_ride [shape=diamond, label="MATCHING未送信の\n新しいrideがあるか"];
  start [label="優先度2\n新しい割当rideのMATCHINGを返す"];
  history [label="優先度3\n完了済み履歴を返す"];
  cursor [label="chair_sent_atを更新\n次pollも配送状態から選択"];
  guard [label="COMPLETED送信済みrideは\n優先度1から除外", fillcolor="#fff4df"];
  poll -> active;
  active -> continue_ride [label="ある"];
  active -> new_ride [label="ない"];
  new_ride -> start [label="ある"];
  new_ride -> history [label="ない"];
  continue_ride -> cursor;
  start -> cursor;
  history -> cursor;
  guard -> active;
}

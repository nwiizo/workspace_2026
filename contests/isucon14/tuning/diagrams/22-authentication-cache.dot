digraph AuthenticationCache {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.45", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 22: 認証token検索をprocess内cacheへ移す", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="14", penwidth="1.8", margin="0.18,0.12"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  request [label="全API request\naccess token"];
  map [shape=diamond, label="HashMapに\n主体があるか"];
  hit [label="cache hit\nDBなしでuser / owner / chair取得", fillcolor="#d8efeb"];
  miss [label="cache miss\nDBへ1回fallback"];
  populate [label="取得結果をcacheへ追加"];
  init [label="起動・initialize後\n全主体をDBから再読込", fillcolor="#fff4df"];
  result [label="認証SQL\n139,690回 → 657回", fillcolor="#d8efeb"];
  request -> map;
  map -> hit [label="ある"];
  map -> miss [label="ない"];
  miss -> populate -> hit;
  init -> map [label="世代を再構築"];
  hit -> result;
}

digraph NotificationConnectionReuseRejected {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.44", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 35: 局所改善より先に通知対象の正しさを直す", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.17,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  reuse [label="同じPoolConnectionで\nride確認 → transaction開始"];
  benefit [label="2回目のpool acquireを0回へ", fillcolor="#d8efeb"];
  select [label="chair通知はupdated_at最大の\nrideだけを先に選択"];
  hidden [label="別rideに未送信statusがあっても\n選択前に見失う", fillcolor="#fde2cf"];
  errors [label="CODE=29 / CODE=26\nerror上限でpass=false"];
  decision [label="connection再利用は一旦revert\nride選択の配送状態機械を先に修正", fillcolor="#fff4df"];
  reuse -> benefit;
  reuse -> select -> hidden -> errors -> decision;
  benefit -> decision [style=dashed, label="局所効果だけでは採用不可"];
}

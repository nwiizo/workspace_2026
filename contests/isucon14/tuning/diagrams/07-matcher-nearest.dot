digraph G {
  graph [bgcolor="#f7f4ed", pad="0.35", ranksep="0.62", nodesep="0.4", fontname="Hiragino Sans", label="Benchmark 07: 候補を絞ってから近いchairを割り当てる", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Hiragino Sans", fontsize=14, color="#19324d", fontcolor="#19324d", fillcolor="#ffffff", penwidth=1.5, margin="0.18,0.12"];
  edge [fontname="Hiragino Sans", fontsize=12, color="#546578", fontcolor="#546578", penwidth=1.5, arrowsize=0.8];

  mysql [label="MySQL\n未割当ride・空きchair・最新位置を\nINDEXで最大64件ずつ取得"];
  rust [label="Rust\n各rideとchairのマンハッタン距離を比較"];
  choose [label="最古rideから最短のchairを選ぶ\n選んだchairは候補から除外", fillcolor="#d8efea"];
  benefit [label="pickupまでの移動が短くなる\n同じ60秒で完了rideが増える"];
  limit [label="注意: 貪欲法は各時点の最良\nbatch全体の総距離が最小とは限らない", fillcolor="#fff7e8"];

  mysql -> rust -> choose -> benefit;
  choose -> limit [style=dashed];
}

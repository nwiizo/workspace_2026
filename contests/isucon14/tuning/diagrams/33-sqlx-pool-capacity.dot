digraph SqlxPoolCapacity {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.45", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 33: connection上限を増やしてもthroughputは増えない", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.16,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  workload [label="同じ4 CPU / 4 GiB\n同じworkload"];
  p50 [label="pool 50\nacquire queueでbackpressure", fillcolor="#d8efeb"];
  p75 [label="pool 75\nDBへ流す同時処理が増える"];
  p100 [label="pool 100\nさらに同時実行を増やす", fillcolor="#fde2cf"];
  lock50 [label="row-lock競合とconnection所有を抑制"];
  lock75 [label="acquire待ちは減るが\nrow-lock待ち・所有時間が増える"];
  lock100 [label="CPU・lock競合がさらに増える"];
  scores [label="中央値\n50: 107,234 / 75: 105,867 / 100: 103,720"];
  decision [label="上限50を維持\n待ち行列を入口側へ置く", fillcolor="#d8efeb"];
  workload -> p50;
  workload -> p75;
  workload -> p100;
  p50 -> lock50 -> scores;
  p75 -> lock75 -> scores;
  p100 -> lock100 -> scores;
  scores -> decision;
}

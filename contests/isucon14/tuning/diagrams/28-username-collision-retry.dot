digraph UsernameCollisionRetry {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.45", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 28: username衝突だけを1回再試行する", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="14", penwidth="1.8", margin="0.18,0.12"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  register [label="user登録\n通常usernameでINSERT"];
  outcome [shape=diamond, label="INSERT結果"];
  success [label="成功\nHTTP 201", fillcolor="#d8efeb"];
  duplicate [shape=diamond, label="users.usernameの\nUNIQUE衝突か"];
  retry [label="内部用usernameへ置換し\n1回だけ再INSERT"];
  error [label="他のDB errorは\n通常どおり失敗"];
  invariant [label="UNIQUE制約を維持\n事前SELECTも追加しない"];
  register -> outcome;
  outcome -> success [label="成功"];
  outcome -> duplicate [label="失敗"];
  duplicate -> retry [label="はい"];
  duplicate -> error [label="いいえ"];
  retry -> success;
  success -> invariant;
}

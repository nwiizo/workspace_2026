digraph OwnerSalesBoundary {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.42", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 24: 売上の完了時刻を外部決済成功後へ移す", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.16,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  old_eval [label="変更前\nevaluation更新\nupdated_atが完了時刻になる", fillcolor="#fde2cf"];
  old_pay [label="外部決済で待機"];
  old_response [label="評価responseはまだ未受信"];
  old_sales [label="owner売上には先に現れる\n完了境界が逆転"];
  lock [label="変更後\nrideをlockして決済情報を準備"];
  pay [label="外部決済成功"];
  finalize [label="COMPLETED・stats・evaluation・\ncompleted_atを最終transactionで確定", fillcolor="#d8efeb"];
  response [label="同じcompleted_atをresponseへ返す"];
  consistent [label="決済・DB・owner売上の\n完了境界が一致", fillcolor="#d8efeb"];
  old_eval -> old_pay -> old_response -> old_sales;
  lock -> pay -> finalize -> response -> consistent;
  {rank=same; old_eval; lock}
  {rank=same; old_pay; pay}
}

digraph NotificationPayloadCache {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.44", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 26: payload cacheとpoll間隔を状態に合わせる", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.17,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  poll [label="通知poll"];
  cache [shape=diamond, label="recipientのpayload cacheと\ndependency revisionが有効か"];
  db [label="cache miss\nDBからpayload構築"];
  store [label="payloadとrevisionを保存"];
  pending [shape=diamond, label="未送信statusが\n残っているか"];
  fast [label="30ms\n状態進行を早く発見"];
  slow [label="100ms\n状態不変時のclosed-loop loadを抑制", fillcolor="#d8efeb"];
  invalidate [label="status・stats変更でrevision更新\n古いpayloadを無効化", fillcolor="#fff4df"];
  poll -> cache;
  cache -> pending [label="hit"];
  cache -> db [label="miss"];
  db -> store -> pending;
  pending -> fast [label="ある"];
  pending -> slow [label="ない"];
  invalidate -> cache;
}

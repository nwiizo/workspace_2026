digraph NearbyFilter {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.5", ranksep="0.55", fontname="Hiragino Sans", labelloc="t", label="Benchmark 16: nearbyの未完了判定を履歴検索からrideの現在値へ変える", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="14", penwidth="1.8", margin="0.18,0.12"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="12", penwidth="1.8", arrowsize="0.8"];

  chairs [label="active chairごとに\n未完了rideがあるか確認"];
  old [label="変更前\nrideごとにstatus履歴を参照", fillcolor="#fde2cf"];
  history [label="ride_statusesを時刻順に読み\n最新1件を選ぶ"];
  loops [label="dependent subquery\n1,671 loops"];
  old_time [label="antijoin 17.9ms\nquery全体 28.2ms"];
  new [label="変更後\nride rowのevaluationを参照", fillcolor="#d8efeb"];
  current [label="rides.evaluation IS NULL\n同じ行の現在値を1回確認"];
  no_history [label="status履歴のsort・lookupなし"];
  new_time [label="antijoin 3.43ms\nquery全体 10.1ms", fillcolor="#d8efeb"];
  unchanged [label="最新位置の取得と距離計算は同じ\n返すchair集合も同じ"];

  chairs -> old [label="旧判定"];
  chairs -> new [label="新判定"];
  old -> history -> loops -> old_time;
  new -> current -> no_history -> new_time;
  old_time -> unchanged;
  new_time -> unchanged;

  {rank=same; old; new}
  {rank=same; history; current}
  {rank=same; loops; no_history}
  {rank=same; old_time; new_time}
}

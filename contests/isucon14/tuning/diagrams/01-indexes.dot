digraph G {
  graph [bgcolor="#f7f4ed", pad="0.35", ranksep="0.65", nodesep="0.4", fontname="Hiragino Sans", label="Benchmark 01: 全件走査をB-tree INDEX検索へ変える", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Hiragino Sans", fontsize=14, color="#19324d", fontcolor="#19324d", fillcolor="#ffffff", penwidth=1.5, margin="0.18,0.12"];
  edge [fontname="Hiragino Sans", fontsize=12, color="#546578", fontcolor="#546578", penwidth=1.5, arrowsize=0.8];

  query [label="検索条件\nchair_id = ?\n新しい順の1件"];
  scan [label="INDEXなし\n全行を読む → 条件判定 → sort\n行数に比例して仕事が増える", fillcolor="#fce2cf"];
  root [label="B-tree root"];
  branch [label="chair_idの範囲"];
  leaf [label="created_at順のleaf\n末尾1件"];
  row [label="必要な行だけ取得", fillcolor="#d8efea"];
  write [label="交換条件\nINSERT / UPDATE時は\nテーブル本体とINDEXを両方更新"];

  query -> scan [label="変更前"];
  query -> root [label="変更後"];
  root -> branch -> leaf -> row;
  row -> write [style=dashed, label="速いreadの代わりに"];
}

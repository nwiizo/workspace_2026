digraph G {
  graph [bgcolor="#f7f4ed", pad="0.35", ranksep="0.62", nodesep="0.4", fontname="Hiragino Sans", label="Benchmark 10: polling間隔はDB負荷と状態発見の交換条件", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Hiragino Sans", fontsize=14, color="#19324d", fontcolor="#19324d", fillcolor="#ffffff", penwidth=1.5, margin="0.18,0.12"];
  edge [fontname="Hiragino Sans", fontsize=12, color="#546578", fontcolor="#546578", penwidth=1.5, arrowsize=0.8];

  short [label="短い間隔\n状態変化を早く発見\n通知GET・SQL・COMMITは増える"];
  long [label="長い間隔\n空pollingとDB負荷は減る\n次の操作開始が遅れる"];
  loop [label="通知を受けて次のride操作へ進むため\n発見遅延はride中に何度も累積"];
  test [label="30 / 50 / 100msを比較\nrequest数・COMMIT・完了数・scoreを確認"];
  result [label="50ms・100msでscore改善なし\n30msを維持", fillcolor="#d8efea"];
  next [label="次は間隔ではなく\ncache / long pollingで空仕事を減らす"];

  short -> loop;
  long -> loop;
  loop -> test -> result -> next;
}

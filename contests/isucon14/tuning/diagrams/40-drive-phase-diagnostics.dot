digraph DrivePhaseDiagnostics {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.43", ranksep="0.48", fontname="Hiragino Sans", labelloc="t", label="Benchmark 40: coordinate response待ちが次の移動tickを止める", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.16,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  move [label="benchmarkerが1 tick移動"];
  post [label="coordinate POST"];
  wait [label="responseまで次の移動を開始しない"];
  server [label="server平均76.515ms"];
  pool [label="pool.acquire平均64.349ms\nserver時間の約84.1%", fillcolor="#fde2cf"];
  update [label="current UPDATE平均2.681ms"];
  ticks [label="応答遅延から予測したblocked tick\n3,678"];
  actual [label="実際の余分tick\n3,718"];
  conclusion [label="drive遅延の主因はSQL前のpool待ち\ncoordinate用接続の隔離を検証", fillcolor="#d8efeb"];
  move -> post -> wait;
  post -> server -> pool;
  server -> update;
  wait -> ticks -> actual -> conclusion;
  pool -> conclusion;
}

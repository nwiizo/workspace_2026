digraph OwnerDistanceRecurrence {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.4", ranksep="0.48", fontname="Hiragino Sans", labelloc="t", label="Benchmark 47: 移動順とwall clock順のずれが存在しない距離を作る", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.16,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  actual [label="実際の移動順\nA → B → C → D", fillcolor="#d8efeb"];
  observed [label="各requestでUtc::now()を採取"];
  clock [label="同じchairのcreated_atが逆行\nA → D → B → C", fillcolor="#fde2cf"];
  lag [label="owner SQLはcreated_at順にLAG"];
  false_distance [label="distance(A,D) + distance(D,B) + distance(B,C)\n存在しない往復を加算"];
  code [label="owner累積距離が過大\nCODE=26"];
  diagnosis [label="chair ID・microsecond時刻・\nbenchmarker履歴を結合して原因確定", fillcolor="#d8efeb"];
  actual -> observed -> clock -> lag -> false_distance -> code;
  actual -> diagnosis;
  code -> diagnosis;
}

digraph MatcherRegionBoundary {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.43", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 37: 候補取得から地域を分けて遠距離割当を防ぐ", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.17,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  old [label="変更前\n全地域から古いride最大64件\n空きchair最大64件"];
  skew [label="一方の地域だけで候補枠を消費"];
  cross [label="地域をまたぐ遠距離割当\nchair供給が長時間失われる", fillcolor="#fde2cf"];
  split [label="変更後\n座標境界で地域を判定", fillcolor="#d8efeb"];
  quota [label="地域ごとにride・chairを\n最大64件ずつ取得"];
  local [label="同じ地域内だけで距離比較・割当"];
  result [label="候補段階のstarvationと\nCODE=32を防止", fillcolor="#d8efeb"];
  old -> skew -> cross;
  split -> quota -> local -> result;
  {rank=same; old; split}
}

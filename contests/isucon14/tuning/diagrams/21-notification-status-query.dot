digraph NotificationStatusQuery {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.45", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 21: SQL本数の削減とDB仕事量の削減は同じではない", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="14", penwidth="1.8", margin="0.18,0.12"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  notification [label="通知status取得"];
  old [label="変更前\n未送信status検索\n必要時だけ最新status検索"];
  old_cost [label="2 SQLの可能性\n単純なINDEX lookup"];
  trial [label="試作\nCTE + UNION ALLで1 SQL", fillcolor="#fde2cf"];
  trial_cost [label="毎回2候補を組み立て\n走査行・一時集合が増加"];
  compare [label="累積実行時間\n約32秒 → 約54秒"];
  decision [label="1 SQL案を不採用\n単純な2段階へ戻す", fillcolor="#d8efeb"];
  notification -> old -> old_cost -> compare;
  notification -> trial -> trial_cost -> compare -> decision;
  {rank=same; old; trial}
  {rank=same; old_cost; trial_cost}
}

digraph CouponUsedByIndex {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.45", ranksep="0.55", fontname="Hiragino Sans", labelloc="t", label="Benchmark 15: 高頻度のcoupon検索を全件走査からINDEX lookupへ変える", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="15", penwidth="1.8", margin="0.18,0.12"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="12", penwidth="1.8", arrowsize="0.8"];

  polling [label="30ms間隔の通知\nfare計算から同じ検索を反復"];
  query [label="SELECT ... FROM coupons\nWHERE used_by = ride_id"];
  before [label="変更前\nused_byを先頭に持つINDEXなし", fillcolor="#fde2cf"];
  scan [label="coupon tableを先頭から確認\n約1,000行 / 実行"];
  before_cost [label="平均0.928ms × 約6万回\nMySQL CPUとconnection待ちが累積"];
  after [label="変更後\nINDEX (used_by)", fillcolor="#d8efeb"];
  lookup [label="B-treeでride IDの範囲へ移動\n一致する0〜1行だけ取得"];
  after_cost [label="平均0.060ms\nconnectionを早くpoolへ返す"];
  result [label="他の通知・座標更新・matcherが進む\n完了rideとscoreが増加", fillcolor="#d8efeb"];
  tradeoff [label="交換条件\ncoupon INSERT / used_by UPDATE時は\nINDEXも更新する", fillcolor="#fff4df"];

  polling -> query;
  query -> before [label="旧経路"];
  query -> after [label="新経路"];
  before -> scan -> before_cost;
  after -> lookup -> after_cost -> result;
  after -> tradeoff [style=dashed, label="write cost"];

  {rank=same; before; after}
  {rank=same; scan; lookup}
  {rank=same; before_cost; after_cost}
}

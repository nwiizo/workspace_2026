digraph LatestLocationCache {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.45", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 18: 位置履歴と現在位置の責務を分ける", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="14", penwidth="1.8", margin="0.18,0.12"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  old [label="変更前\nchair_locations履歴から\nchairごとに最新1件をsort", fillcolor="#fde2cf"];
  write [label="座標更新transaction"];
  history [label="chair_locationsへ履歴INSERT"];
  current [label="chair_current_locationsをUPSERT\n1 chair = 1 row", fillcolor="#d8efeb"];
  cache [label="process内cache\n2秒ごとにDBと再同期"];
  reads [label="nearby / matcher\n履歴scanではなく現在値を読む"];
  gate [label="initialize時はmaintenance gate\nDBとcacheを同じ世代へ戻す", fillcolor="#fff4df"];
  result [label="最新位置取得の行数を固定\nhistoryは監査・距離計算用に保持"];
  old -> result [style=dashed, label="除去"];
  write -> history;
  write -> current -> cache -> reads -> result;
  gate -> current;
  gate -> cache;
}

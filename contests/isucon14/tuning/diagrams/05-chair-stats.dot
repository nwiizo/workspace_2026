digraph G {
  graph [bgcolor="#f7f4ed", pad="0.35", ranksep="0.62", nodesep="0.4", fontname="Hiragino Sans", label="Benchmark 05: rideごとのN+1を集約SQLへ変える", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Hiragino Sans", fontsize=14, color="#19324d", fontcolor="#19324d", fillcolor="#ffffff", penwidth=1.5, margin="0.18,0.12"];
  edge [fontname="Hiragino Sans", fontsize=12, color="#546578", fontcolor="#546578", penwidth=1.5, arrowsize=0.8];

  rides [label="変更前\nchairのridesを1回取得"];
  per [label="rideごとにstatusを取得\n1 + R回のSQL", fillcolor="#fce2cf"];
  rust [label="Rustで状態判定・件数・平均"];
  join [label="変更後: 1 SQL\nridesとride_statusesをJOIN"];
  gate [label="ride単位にGROUP BY\n必要な3状態があるrideだけ残す"];
  aggregate [label="COUNTとAVGを1行で返す", fillcolor="#d8efea"];
  effect [label="通知transaction中の\nDB往復とconnection保持を短縮"];

  rides -> per -> rust -> effect;
  join -> gate -> aggregate -> effect;
}

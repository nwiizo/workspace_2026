digraph G {
  graph [bgcolor="#f7f4ed", pad="0.35", ranksep="0.62", nodesep="0.4", fontname="Hiragino Sans", label="Benchmark 06: matcher 1回の処理上限を1件から64件へ", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Hiragino Sans", fontsize=14, color="#19324d", fontcolor="#19324d", fillcolor="#ffffff", penwidth=1.5, margin="0.18,0.12"];
  edge [fontname="Hiragino Sans", fontsize=12, color="#546578", fontcolor="#546578", penwidth=1.5, arrowsize=0.8];

  poll [label="500msごとにmatcher起動"];
  one [label="変更前\n最古ride 1件だけ処理\n上限 約2件/秒", fillcolor="#fce2cf"];
  rides [label="古い未割当rideを最大64件\nFOR UPDATE SKIP LOCKED"];
  chairs [label="空きchairを最大64件\nFOR UPDATE SKIP LOCKED"];
  pair [label="1対1で組み合わせてUPDATE", fillcolor="#d8efea"];
  result [label="割当期限超過は解消\nただしID順選択で距離は悪化"];
  next [label="処理量と選択品質を分離\n次に近いchair選択を改善"];

  poll -> one -> result;
  poll -> rides -> chairs -> pair -> result;
  result -> next;
}

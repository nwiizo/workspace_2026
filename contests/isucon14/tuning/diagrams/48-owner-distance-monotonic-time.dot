digraph OwnerDistanceMonotonicTime {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.43", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 48: chairごとのhigh-water markで保存時刻を単調化する", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.17,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  request [label="chairの座標request"];
  observe [label="observed_at = Utc::now()"];
  mutex [label="chair単位のhigh-water markをlock"];
  normalize [label="recorded_at = max(\nobserved_at,\nprevious + 1µs)", fillcolor="#d8efeb"];
  save [label="chair_locationsへ保存\npreviousをrecorded_atへ更新"];
  order [label="同じchair内で\ncreated_atが必ず単調増加"];
  lag [label="owner SQLのLAGが\n実際の移動順を維持"];
  result [label="87,005区間のspeed超過0\n通常3走error 0", fillcolor="#d8efeb"];
  request -> observe -> mutex -> normalize -> save -> order -> lag -> result;
}

digraph PaymentIdempotency {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.43", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 25: 同じrideの再試行を1回分の決済へ収束させる", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.17,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  request [label="評価request\nIdempotency-Key = ride ID"];
  post [label="決済POST"];
  uncertain [shape=diamond, label="responseが5xx・不明か"];
  retry [label="同じkeyでPOSTを再試行"];
  payment [label="決済service\nkeyごとに結果を1件だけ保持", fillcolor="#d8efeb"];
  finalize [label="成功結果でDB完了transaction"];
  owner [label="owner売上は配送中rideを除外\nclient受信境界も保護"];
  result [label="二重課金と確認GET・全ride取得を削減", fillcolor="#d8efeb"];
  request -> post -> uncertain;
  uncertain -> payment [label="成功"];
  uncertain -> retry [label="不明"];
  retry -> payment;
  payment -> finalize -> owner -> result;
}

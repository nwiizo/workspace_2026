digraph NotificationReuseAdoption {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.45", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 46: 小さいscore差と確実な構造改善を分けて採用する", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="14", penwidth="1.8", margin="0.18,0.12"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  before [label="変更前中央値138,027\n通知missはgeneral poolへ2回並ぶ"];
  after [label="変更後中央値139,198\n同じconnectionを再利用", fillcolor="#d8efeb"];
  variance [label="+0.85%はrun間ばらつきより小さい\n速度向上とは断定しない", fillcolor="#fff4df"];
  structural [label="2回目pool acquireは確実に削除\nSQL・cursor・総接続数は同じ"];
  correctness [label="過去のCODE=29は再発なし"];
  decision [label="general poolの資源効率改善として採用", fillcolor="#d8efeb"];
  before -> after -> variance;
  after -> structural;
  after -> correctness;
  variance -> decision;
  structural -> decision;
  correctness -> decision;
}

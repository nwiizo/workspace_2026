digraph DbPoolPartition20 {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.44", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 43: 3つのpool配分は単調な結果にならない", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.17,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  demand [label="総接続50\ncoordinateとgeneralが共有する有限資源"];
  p16 [label="16 / 34\ncoordinate不足\np95待ち最大"];
  p20 [label="20 / 30\n平均的な配分\ncoordinate待ちは共有pool水準"];
  p24 [label="24 / 26\ncoordinate待ち最小\ngeneralは飽和", fillcolor="#d8efeb"];
  drive [label="drive不満\n16: 79.5% / 20: 80.6% / 24: 74.0%"];
  reason [label="queue相互作用とrun分布により\n配分とscoreは単調に動かない"];
  decision [label="診断で最も良い24 / 26を\n通常3走で確認", fillcolor="#d8efeb"];
  demand -> p16;
  demand -> p20;
  demand -> p24;
  p16 -> drive;
  p20 -> drive;
  p24 -> drive;
  drive -> reason -> decision;
}

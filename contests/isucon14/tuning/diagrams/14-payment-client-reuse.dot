digraph G {
  graph [bgcolor="#f7f4ed", pad="0.35", ranksep="0.62", nodesep="0.4", fontname="Hiragino Sans", label="Benchmark 14: HTTP clientを共有してconnectionを再利用する", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fontname="Hiragino Sans", fontsize=14, color="#19324d", fontcolor="#19324d", fillcolor="#ffffff", penwidth=1.5, margin="0.18,0.12"];
  edge [fontname="Hiragino Sans", fontsize=12, color="#546578", fontcolor="#546578", penwidth=1.5, arrowsize=0.8];

  eval [label="ride評価request"];
  old [label="変更前\nPOST / GETごとにClient生成・破棄"];
  reconnect [label="毎回TCP接続とsocket管理\npoolを再利用できない", fillcolor="#fce2cf"];
  shared [label="変更後\nAppStateにreqwest::Clientを1個保持"];
  pool [label="同じhostのidle connectionをpoolから再利用", fillcolor="#d8efea"];
  payment [label="POST /payments\n必要なら確認GET・retry"];
  complete [label="評価とCOMPLETEDを早く確定\nchairが次のrideへ戻る"];
  score [label="完了評価数とscoreが増加"];

  eval -> old -> reconnect -> payment;
  eval -> shared -> pool -> payment;
  payment -> complete -> score;
}

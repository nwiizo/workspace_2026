digraph DbPoolPartitionAdoption {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.46", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 44: 24 / 26を診断から通常runの採用判断へ進める", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="14", penwidth="1.8", margin="0.18,0.12"];

digraph InvitationConcurrency {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.42", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 29: 招待者rowを並行登録の直列化地点にする", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.16,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  old [label="変更前\ncoupons(code)をFOR UPDATE"];
  gaps [label="異なる招待codeでも\nB-tree gap lockが重なる"];
  deadlock [label="deadlock / error budget消費", fillcolor="#fde2cf"];
  lookup [label="変更後\nUNIQUE invitation_codeで招待者1行を検索"];
  lock [label="招待者user rowをFOR UPDATE", fillcolor="#d8efeb"];
  count [label="同じ招待codeのrewardを数え\n3件未満だけ追加"];
  stable [label="reward coupon IDは\n時刻でなく新規user IDから生成"];
  result [label="同じ招待は直列化\n異なる招待は並行可能", fillcolor="#d8efeb"];
  old -> gaps -> deadlock;
  lookup -> lock -> count -> stable -> result;
  {rank=same; old; lookup}
}

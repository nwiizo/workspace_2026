digraph DbPoolPartition16 {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.46", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 41: 総数50のままcoordinateへ16本を予約する", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="14", penwidth="1.8", margin="0.18,0.12"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  total [label="DB connection総数 50"];
  coordinate [label="coordinate専用 16\n毎秒約1,000 request", fillcolor="#fde2cf"];
  general [label="general 34\n通知・評価・matcher"];
  cq [label="coordinate queueが集中\nacquire p95 242.474ms"];
  gq [label="general側は軽くなる"];
  result [label="drive不満79.5%\n用途分離ではなく予約数16を不採用", fillcolor="#fff4df"];
  next [label="総数を増やさず\ncoordinate比率を上げて比較", fillcolor="#d8efeb"];
  total -> coordinate;
  total -> general;
  coordinate -> cq -> result;
  general -> gq -> result;
  result -> next;
}

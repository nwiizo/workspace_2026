digraph ResponseDelivery {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.4", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 23: DB完了とclient受信の間を配送状態として扱う", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.16,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  commit [label="評価transaction COMMIT\nserverはchairを空きと判定"];
  body [label="response bodyをHyperへ渡す"];
  receive [label="benchmarkerが最後まで受信\nEvaluated=true"];
  gap [label="配送中の競合窓\nnearbyへ再掲載するとCODE=30", fillcolor="#fde2cf"];
  snapshot [label="nearby開始時\nrevisionと除外chairをsnapshot", fillcolor="#d8efeb"];
  completion [label="SQL待機中の完了も\ncompletion revisionで検出"];
  lease [label="body drop後もdelivery lease中は除外"];
  safe [label="client受信前のchairを\nnearbyへ返さない", fillcolor="#d8efeb"];
  commit -> body -> receive;
  commit -> gap -> receive [style=dashed];
  snapshot -> completion -> lease -> safe;
  gap -> snapshot [label="閉じる"];
}

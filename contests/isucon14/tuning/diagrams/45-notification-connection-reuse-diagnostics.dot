digraph NotificationReuseDiagnostics {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.44", ranksep="0.5", fontname="Hiragino Sans", labelloc="t", label="Benchmark 45: 配送状態機械を維持したままconnection所有だけ変える", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.17,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  miss [label="通知cache miss"];
  acquire [label="general poolから1回acquire"];
  select [label="配送状態機械で\ncurrent rideを選択"];
  exists [label="同じconnectionで存在確認"];
  transaction [label="返却せず同じconnectionから\ntransaction開始", fillcolor="#d8efeb"];
  cursor [label="通知SQL・cursor更新・\ntransaction境界は変更なし"];
  result [label="2回目acquire\n878 / 878 sampleで0回\nCODE=29再発なし", fillcolor="#d8efeb"];
  miss -> acquire -> select -> exists -> transaction -> cursor -> result;
}

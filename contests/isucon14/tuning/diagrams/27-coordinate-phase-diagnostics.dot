digraph CoordinatePhaseDiagnostics {
  graph [bgcolor="#f7f4ed", pad="0.25", nodesep="0.42", ranksep="0.48", fontname="Hiragino Sans", labelloc="t", label="Benchmark 27: coordinate遅延をphaseへ分けて支配項を特定する", fontsize="22"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#17324d", fontcolor="#17324d", fontname="Hiragino Sans", fontsize="13", penwidth="1.8", margin="0.16,0.11"];
  edge [color="#58708a", fontcolor="#58708a", fontname="Hiragino Sans", fontsize="11", penwidth="1.8", arrowsize="0.8"];
  request [label="coordinate handler\n1/64 sampling"];
  begin [label="pool.begin()\n平均32.452ms / p95 93.651ms", fillcolor="#fde2cf"];
  current [label="current-state write\n平均1.633ms / p95 4.185ms"];
  rest [label="ride判定・status・COMMIT"];
  total [label="handler全体\n平均40.089ms / p95 105.296ms"];
  hypothesis [label="当初仮説\ncurrent UPDATEのrow lockが支配"];
  update [label="観測で仮説を更新\npool取得とBEGINを次に分離", fillcolor="#d8efeb"];
  request -> begin -> current -> rest -> total;
  hypothesis -> current [style=dashed];
  total -> update;
}

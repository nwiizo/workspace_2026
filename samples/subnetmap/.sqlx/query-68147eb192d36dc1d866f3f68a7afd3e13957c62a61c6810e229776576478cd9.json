  "query": "SELECT s.id, s.cidr::TEXT as \"cidr!\", s.name, s.description, s.parent_id,\n           s.used_count, s.total_addresses, s.created_at, s.updated_at\n           FROM subnets s\n           JOIN vlan_subnet_links vsl ON s.id = vsl.subnet_id\n           WHERE vsl.vlan_id = $1\n           ORDER BY s.cidr",

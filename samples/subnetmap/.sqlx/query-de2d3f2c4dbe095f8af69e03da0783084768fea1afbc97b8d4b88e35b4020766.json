  "db_name": "PostgreSQL",
  "query": "SELECT id, name, cidr::TEXT as \"cidr!\",\n           similarity(name, $1) as \"sim!\"\n           FROM subnets\n           WHERE name % $1 OR cidr::TEXT LIKE '%' || $1 || '%'\n           ORDER BY similarity(name, $1) DESC\n           LIMIT 10",
